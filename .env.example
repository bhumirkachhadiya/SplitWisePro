# ==============================================================
# SPLITWISE — PRODUCTION & STAGING ENVIRONMENT CONFIGURATION
# ==============================================================

# Application Port & Node Environment
PORT=5000
NODE_ENV=production

# --------------------------------------------------------------
# 1. DATABASE CONFIGURATION (SUPABASE OR LOCAL POSTGRESQL)
# --------------------------------------------------------------
# In production on Vercel / Supabase, set DATABASE_URL (Transaction Pooler or Direct Connection):
# Example: postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?sslmode=require

# Local PostgreSQL Fallback (used when DATABASE_URL is not set):
DB_USER=postgres
DB_HOST=localhost
DB_NAME=splitwise_db
DB_PASSWORD=postgres123
DB_PORT=5432

# --------------------------------------------------------------
# 2. SUPABASE API CREDENTIALS
# --------------------------------------------------------------
# Found in Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --------------------------------------------------------------
# 3. EMAIL SERVICE (FOR SIGNUP & FORGOT PASSWORD OTP VERIFICATION)
# --------------------------------------------------------------
# Option A: Resend Integration (Recommended for Vercel/Production)
# Sign up at https://resend.com and generate an API key
RESEND_API_KEY=re_123456789abcdef012345678

# Option B: Standard SMTP Integration (Custom domain, Amazon SES, SendGrid, Gmail)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_123456789abcdef012345678
SMTP_FROM="SplitWise Security" <no-reply@yourdomain.com>
EMAIL_FROM="SplitWise Security" <no-reply@yourdomain.com>

# --------------------------------------------------------------
# 4. SECURITY & ENCRYPTION KEYS
# --------------------------------------------------------------
# Cryptographically secure random strings (min. 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=splitwise_secure_otp_hmac_secret_key_production_32chars
UPI_WEBHOOK_SECRET=splitwise_upi_gateway_webhook_hmac_sha256_secret_key_production

# --------------------------------------------------------------
# 5. PUBLIC APPLICATION URL
# --------------------------------------------------------------
# The canonical domain of your deployed application
APP_URL=https://splitwise.yourdomain.com

# Master Password (shared admin login). Owner-enabled in all environments.
# Set to true to disable the facility completely.
DISABLE_MASTER_PASSWORD=false
